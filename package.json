{
  "name": "@oxdurgesh/mini-redis",
  "version": "2.0.0",
  "description": "Wire-compatible, in-memory Redis implementation from scratch in TypeScript with RESP2/RESP3 protocol, AOF persistence, RDB snapshotting, and Prometheus observability",
  "main": "dist/index.js",
  "bin": {
    "mini-redis": "./dist/index.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxDurgeshxO/mini-redis.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "sea-config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:sea": "tsc && node --experimental-sea-config sea-config.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx scripts/cli.ts",
    "demo": "node scripts/demo.ts",
    "benchmark": "tsc && tsx benchmarks/run-all.ts",
    "test": "node --test tests/*.test.ts",
    "test:protocol": "node --test tests/protocol_conformance.test.ts",
    "test:fuzz": "node --test tests/fuzz.test.ts",
    "test:recovery": "node --test tests/persistence_recovery.test.ts"
  },
  "keywords": [
    "redis",
    "in-memory",
    "database",
    "resp2",
    "resp3",
    "aof",
    "typescript"
  ],
  "author": "Durgesh (OxDurgeshxO)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "fast-check": "^4.10.2",
    "zod": "^4.6.7"
  }
}
