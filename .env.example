# mini-redis Configuration Template

# Network configuration
REDIS_PORT=6379
METRICS_PORT=9121
REDIS_MAX_CLIENTS=10000

# Persistence configuration
REDIS_AOF=true
REDIS_AOF_PATH=appendonly.aof
REDIS_FSYNC_POLICY=everysec  # Options: always | everysec | no
REDIS_RDB_PATH=dump.rdb

# Memory management & eviction
REDIS_MAX_MEMORY=0           # Max memory in bytes (0 = unlimited)
REDIS_MAXMEMORY_POLICY=noeviction # Options: noeviction | allkeys-lru | volatile-ttl

# Observability
LOG_LEVEL=INFO               # Options: DEBUG | INFO | WARN | ERROR
