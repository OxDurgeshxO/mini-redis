{
  "name": "@oxdurgesh/mini-redis",
  "version": "1.1.0",
  "description": "Wire-compatible, in-memory Redis implementation from scratch in TypeScript with RESP2/RESP3 protocol, AOF persistence, and RDB snapshotting",
  "main": "dist/index.js",
  "bin": {
    "mini-redis": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:sea": "tsc && node --experimental-sea-config sea-config.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo": "node scripts/demo.ts",
    "benchmark": "node scripts/benchmark.ts",
    "test": "node --test tests/server.test.ts tests/resp3.test.ts tests/aof.test.ts"
  },
  "keywords": [
    "redis",
    "in-memory",
    "database",
    "resp2",
    "resp3",
    "aof",
    "typescript"
  ],
  "author": "Durgesh (OxDurgeshxO)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
